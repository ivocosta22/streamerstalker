{
  "name": "streamerstalker-chat",
  "productName": "StreamerStalker Chat",
  "version": "1.0.0",
  "description": "StreamerStalker Chat Client",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "dependencies": {
    "dotenv": "^16.6.1"
  },
  "devDependencies": {
    "electron": "^44.4.3",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.ivocosta.streamerstalker.chat",
    "productName": "StreamerStalker Chat",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "node_modules/dotenv/**"
    ],
    "extraResources": [
      {
        "from": "../player/assets/iconChat.png",
        "to": "iconChat.png"
      },
      {
        "from": "../.env",
        "to": ".env"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "../player/assets/iconChat.png"
    },
    "nsis": {
      "oneClick": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
