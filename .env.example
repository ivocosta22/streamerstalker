# Note: The data in this example .env file is mock data

# --------------- Twitch Variables ---------------

# Twitch Bot Command Prefix
TWITCH_COMMAND_PREFIX=!

# Twitch Channel where the bot will log
TWITCH_CHANNEL=mockstreamer

# Twitch Channel case sensitive name
TWITCH_CHANNEL_CASE_SENSITIVE=MockStreamer

# Twitch Channel User ID
TWITCH_CHANNEL_USERID=91234567

# Twitch Bot Username
TWITCH_BOT_USERNAME=mockbotaccount

# Twitch Bot User ID
TWITCH_BOT_USERID=845672391

# Twitch Bot Account OAuth
TWITCH_BOT_OAUTH=oauth:9x4k2lmno8pqrs7tuvwx1yzab2cdef

# Twitch Bot User Authorization Link for oAuth token renew
TWITCH_BOT_AUTHORIZATION_LINK=https://id.twitch.tv/oauth2/authorize?response_type=code&client_id=abcdefghijklmnopqrstuvwxyz123456&redirect_uri=http://localhost:3000&scope=channel:read:redemptions%20moderation:read%20channel:moderate%20user:write:chat%20moderator:manage:banned_users%20moderator:manage:announcements%20channel:manage:vips

# Twitch Bot API Client ID
TWITCH_BOT_API_CLIENTID=abcdefghijklmnopqrstuvwxyz123456

# Twitch Bot API Client Secret
TWITCH_BOT_API_CLIENT_SECRET=abcdefghijklmnopqrstuvwxyz123456

# Twitch API Endpoint
TWITCH_API_ENDPOINT=https://api.twitch.tv/helix

# Twitch User Token Endpoint
TWITCH_USER_TOKEN_ENDPOINT=https://id.twitch.tv/oauth2/token

# Enable/disable all outgoing Twitch chat messages
CHAT_ENABLED=true

# --------------- Streamer Info ---------------

# Streamer's Kick channel URL (used by !kick and the go-live Discord message)
KICK_CHANNEL_URL=https://kick.com/mockstreamer

# Pull Kick chat into the chat page and OBS overlay. Set to false to turn it off.
KICK_CHAT_ENABLED=true

# Numeric Kick chatroom id. The bot tries to look this up from KICK_CHANNEL_URL
# on boot, but Cloudflare usually blocks that call — if the log says the lookup
# failed, set it here. To find it, open your Kick channel in a browser and visit:
#   https://kick.com/api/v2/channels/<your-channel-slug>
# then copy the "chatroom" -> "id" value. Leave empty to rely on auto-detection.
KICK_CHATROOM_ID=

# Kick API credentials (for sending messages as the bot).
# Create an app at Account Settings -> Developer on the bot's Kick account.
# Redirect URI must be: http://localhost:3000/kick/callback
KICK_CLIENT_ID=01ABCDEF0GHIJKLM1234567890
KICK_CLIENT_SECRET=abcdef1234567890abcdef1234567890abcdef1234567890abcdef1234567890

# Numeric Kick user ID of the streamer's channel (not the chatroom ID).
# The bot sends messages into this channel. Find it in the page source of your Kick channel.
KICK_BROADCASTER_USER_ID=

# Streamer's IANA timezone (used by !time). Examples: Europe/Lisbon, America/New_York, Asia/Tokyo
STREAMER_TIMEZONE=Europe/Lisbon

# --------------- Discord Variables ---------------

# Discord Bot Token
DISCORD_BOT_TOKEN=QWERTYUIOPASDFGHJKLZXCVBNM.abCdEf.1234567890abcdefghijklmnopqrstuvwxyz

# Discord Bot ID
DISCORD_BOT_ID=123456789012345678

# Discord Server ID
DISCORD_SERVER_ID=234567890123456789

# Discord Channel ID for Discord -> Twitch Communication
DISCORD_TWITCH_CHANNEL_COMMUNICATION_ID=345678901234567890

# Discord Channel ID where the go-live @everyone announcement is posted
DISCORD_GO_LIVE_CHANNEL_ID=456789012345678901

# --------------- OBS Variables ---------------

# OBS Websocket Endpoint
OBS_WS_URL=ws://127.0.0.1:4455

# OBS Websocket Password
OBS_WS_PASSWORD=MockPassword1234AbCd

# OBS Auto-Reconnect time (miliseconds)
OBS_AUTO_RECONNECT_TIME=300000

# --------------- Server ---------------
SERVER_PORT=3000

# --------------- Web Interface ---------------

# Password for the admin control panel (/dashboard, /player, /logs).
# Leave this blank or unset and the control panel is completely disabled —
# that is the safe default if you expose the server to the internet.
WEB_ADMIN_PASSWORD=

# Public base URL, if you expose the bot through Cloudflare Tunnel or similar.
# Only used to print correct links at startup. No trailing slash.
WEB_PUBLIC_URL=

# Set to false to turn off the public read-only pages
# (/commands, /leaderboard, /sounds, /stats)
WEB_PUBLIC_PAGES=true